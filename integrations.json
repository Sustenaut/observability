{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/deploy.yml",
        "k8s/evaluator.yaml",
        "k8s/kustomization.yaml",
        "k8s/page.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/wheel.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.bigquery",
      "paths": [
        "src/observability/bigquery.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "letsencrypt.certs",
      "paths": [
        "k8s/ingress.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "slack.post",
      "paths": [
        ".github/workflows/uptime.yml",
        "pubkit.json",
        "src/observability/uptime.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/pr.yml",
        ".github/workflows/main.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "storage.api",
      "paths": [
        ".github/workflows/deploy.yml",
        "src/observability/store.py",
        "src/observability/cli.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "tailscale.tailnet",
      "paths": [
        "pubkit.json"
      ],
      "mode": "required"
    }
  ],
  "exclude": [
    {
      "path": "tests/steps/test_uptime.py",
      "reason": "A local stand-in for Slack's chat.postMessage that the suite posts to"
    },
    {
      "path": "tests/steps/test_evaluate.py",
      "reason": "A local stand-in for BigQuery's API and Google's token endpoint that the suite queries"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ],
  "other_secrets": [
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "An SSH key to our own server"
    }
  ]
}
