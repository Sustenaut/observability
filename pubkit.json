{
  "kind": "utility",
  "bin": "observability",
  "ci": {
    "language": "python",
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan"
    ],
    "release_app": 5529889
  },
  "secrets": [
    {
      "from": "slack-bot-token",
      "to": "SUSTENAUT_SLACK_BOT_TOKEN",
      "kind": "secret"
    },
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "variables": {
    "names": [
      "OBSERVABILITY_DATASETS",
      "OBSERVABILITY_SENDERS",
      "UPTIME_SLACK_CHANNEL",
      "UPTIME_TARGETS"
    ],
    "deploy": "deploy.yml"
  },
  "signing_keys": [
    {
      "path": "corpus/.publet/signing.key",
      "bitwarden": {
        "project": {
          "id": "377de170-5487-40f7-9a01-b4f50064e1c5",
          "name": "Pub"
        },
        "name": "pub-signing-key-observability"
      }
    }
  ],
  "deploy": {
    "namespace": "observability",
    "host": "observability.sustenaut.eu",
    "workflow": "deploy.yml",
    "gate": "DEPLOY_OBSERVABILITY",
    "needs": [
      {
        "type": "gcp.service-account-key",
        "account": "observability-reader",
        "project": "sustenaut",
        "bitwarden": "observability-reader-key",
        "secret": {
          "name": "evaluator-bigquery-key",
          "key": "key.json",
          "decode": "base64"
        }
      },
      {
        "type": "bitwarden.generated",
        "name": "observability-cookie-secret",
        "shape": "oauth2-proxy-cookie",
        "secret": {
          "name": "observability-page-secrets",
          "key": "cookie-secret"
        }
      },
      {
        "type": "auth.sign-in-client",
        "realm": "team",
        "role": "observability",
        "auth": "https://auth.sustenaut.eu/realms/team",
        "domain": "sustenaut.eu",
        "host": "observability.sustenaut.eu",
        "state": "/root/.config/sustenaut-auth/team-sustenaut.eu",
        "client_name": "sustenaut.eu team sites",
        "register_app": "../auth/register-app.py",
        "approvals": "../shared-infra/infra/auth-approvals.json",
        "access": "https://auth.sustenaut.eu/realms/team/access",
        "secret": {
          "name": "observability-oidc"
        }
      },
      {
        "type": "k8s.manifests",
        "path": "k8s/admin/network-policy.yaml"
      },
      {
        "type": "upstream",
        "name": "storage",
        "health": "https://storage.sustenaut.eu/"
      },
      {
        "type": "storage.tenant",
        "name": "signals",
        "storage": "Sustenaut/storage",
        "url": "https://storage.sustenaut.eu",
        "write": [
          "k8s:observability/evaluator"
        ],
        "private": true,
        "inbox": true
      },
      {
        "type": "github.variable-entry",
        "repository": "Sustenaut/integrations",
        "variable": "INGEST_SIGNALS",
        "path": "/tenant",
        "value": "signals"
      },
      {
        "type": "service.health",
        "path": "/healthz",
        "job": "cronjob/evaluator"
      }
    ]
  }
}
