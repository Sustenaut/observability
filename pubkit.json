{
  "kind": "utility",
  "bin": "observability",
  "ci": {
    "language": "python",
    "release": {}
  },
  "protect": {
    "checks": [
      "ci / passed",
      "release / release",
      "integrations / scan"
    ],
    "release_app": 5529889
  },
  "secrets": [
    {
      "from": "slack-bot-token",
      "to": "SUSTENAUT_SLACK_BOT_TOKEN",
      "kind": "secret"
    },
    {
      "from": "sustenaut-deploy-ssh-key",
      "to": "SUSTENAUT_DEPLOY_SSH_KEY",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_CLIENT_ID",
      "to": "TS_GH_OAUTH_CLIENT_ID",
      "kind": "secret"
    },
    {
      "from": "TS_GH_OAUTH_SECRET",
      "to": "TS_GH_OAUTH_SECRET",
      "kind": "secret"
    },
    {
      "from": "sustenaut-server",
      "to": "SUSTENAUT_SERVER",
      "kind": "variable"
    },
    {
      "from": "sustenaut-known-hosts",
      "to": "SUSTENAUT_KNOWN_HOSTS",
      "kind": "variable"
    }
  ],
  "variables": {
    "names": [
      "OBSERVABILITY_DATASETS",
      "OBSERVABILITY_SENDERS",
      "UPTIME_SLACK_CHANNEL",
      "UPTIME_TARGETS"
    ],
    "deploy": "deploy.yml"
  }
}
